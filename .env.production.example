# ============================================================
# Humanitas-ERP — PRODUCTION Environment Variables
# Copy this to .env.production on your VPS and fill in values.
# NEVER commit this file to git.
# ============================================================

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================
# PostgreSQL database running on VPS host or external
DATABASE_URL=postgresql://humanitas_user:CHANGE_ME@dpg-xxxx.oregon-postgres.render.com/humanitas?sslmode=require

# ============================================================================
# SECURITY (REQUIRED — Change all of these!)
# ============================================================================
JWT_SECRET=CHANGE_ME_super_secret_jwt_key_min_64_chars_long_for_production_use
JWT_REFRESH_SECRET=CHANGE_ME_refresh_token_secret_also_long_and_random_for_security
COOKIE_SECRET=CHANGE_ME_cookie_secret_random
ENCRYPTION_SECRET=CHANGE_ME_encryption_secret_32_chars
MESSAGE_ENCRYPTION_KEY=CHANGE_ME_message_encryption_key

# ============================================================================
# API & FRONTEND URLs (Production Subdomains for Humanitas-ERP)
# ============================================================================
# Backend internal comms
ADMIN_BACKEND_URL=http://admin-api:3000/api/v1

# Public-facing URLs (used by frontends)
ADMIN_API_URL=https://api-admin.humanitas-erp.ziontech.tech/api/v1
TENANT_API_URL=https://api.humanitas-erp.ziontech.tech/api/v1
SOCKET_URL=https://api.humanitas-erp.ziontech.tech

FRONTEND_URL=https://humanitas-erp.ziontech.tech
ADMIN_FRONTEND_URL=https://admin.humanitas-erp.ziontech.tech

# CORS
CORS_ORIGINS=https://humanitas-erp.ziontech.tech,https://admin.humanitas-erp.ziontech.tech

# Build-time args for React frontends
VITE_API_URL=https://api.humanitas-erp.ziontech.tech/api/v1
VITE_ADMIN_API_URL=https://api-admin.humanitas-erp.ziontech.tech/api/v1
VITE_SOCKET_URL=https://api.humanitas-erp.ziontech.tech

# ============================================================================
# BCRYPT
# ============================================================================
BCRYPT_SALT_ROUNDS=12
