# Humanitas Environment Variables for Docker Compose
# Copy this file to .env and fill in your actual values

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================
# Your external PostgreSQL database URL
# Format: postgresql://username:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://humanitas_user:cTscz9mH21j0apxi78dp6NEitb8cmi4N@dpg-d5f8u6q4d50c73ck2n7g-a.oregon-postgres.render.com/humanitas?sslmode=require

# ============================================================================
# SECURITY (REQUIRED - Change these in production!)
# ============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-12345
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-too-67890
COOKIE_SECRET=my-cookie-secret-change-me-abcdef

# ============================================================================
# API URLs (Optional - defaults provided)
# ============================================================================
# Admin Backend URL (for tenant-api to call admin-api)
ADMIN_BACKEND_URL=http://admin-api:3000/api/v1

# Frontend URLs
ADMIN_FRONTEND_URL=http://localhost:5173
TENANT_FRONTEND_URL=http://localhost:1300

# API URLs (for frontend)
ADMIN_API_URL=http://localhost:3000/api/v1
TENANT_API_URL=http://localhost:3001/api/v1
SOCKET_URL=http://localhost:3001

# ============================================================================
# CORS ORIGINS (Optional)
# ============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:1300,http://localhost:3000,http://localhost:3001

# ============================================================================
# BCRYPT (Optional - default: 12)
# ============================================================================
BCRYPT_SALT_ROUNDS=12

# ============================================================================
# NOTES
# ============================================================================
# 1. DATABASE_URL is REQUIRED - must point to your external PostgreSQL
# 2. Never commit .env file to git (already in .gitignore)
# 3. Change all security secrets before production deployment
# 4. SSL is enabled for database connections (sslmode=require)
