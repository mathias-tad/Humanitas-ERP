# ===========================================
# Humanitas Frontend - Environment Variables
# ===========================================

# ===========================================
# API Configuration
# ===========================================

# Main Tenant API Base URL
# Development: /api/v1 (uses Vite proxy)
# Production: https://your-backend-api.com/api/v1
VITE_API_URL=/api/v1

# Socket.IO Connection URL (for real-time features)
# Development: leave empty (uses same origin)
# Production: https://your-backend-api.com (or wss://your-backend-api.com)
VITE_SOCKET_URL=

# File Uploads Base URL
# Development: /uploads (uses Vite proxy)
# Production: https://your-backend-api.com/uploads or https://your-cdn.com/uploads
VITE_UPLOADS_URL=/uploads

# ===========================================
# Production Example Configuration
# ===========================================
# When deploying to production (e.g., Vercel), use:
# VITE_API_URL=https://your-backend.onrender.com/api/v1
# VITE_SOCKET_URL=https://your-backend.onrender.com
# VITE_UPLOADS_URL=https://your-backend.onrender.com/uploads
