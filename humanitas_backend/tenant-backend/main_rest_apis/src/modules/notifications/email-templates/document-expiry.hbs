<h2>Document Expiry Alert ⚠️</h2>
<p>Hi <strong>{{employeeName}}</strong>,</p>
<p>The following document is expiring soon:</p>
<table style="width:100%;border-collapse:collapse;margin:16px 0">
  <tr><td style="padding:8px;border-bottom:1px solid #eee;color:#666">Document</td><td style="padding:8px;border-bottom:1px solid #eee"><strong>{{documentName}}</strong></td></tr>
  <tr><td style="padding:8px;border-bottom:1px solid #eee;color:#666">Expiry Date</td><td style="padding:8px;border-bottom:1px solid #eee"><strong style="color:#ef4444">{{expiryDate}}</strong></td></tr>
  <tr><td style="padding:8px;color:#666">Days Remaining</td><td style="padding:8px"><strong>{{daysRemaining}} days</strong></td></tr>
</table>
<a href="{{deepLink}}" class="btn">View Document</a>
