<h2>New Task Assigned 📋</h2>
<p>Hi <strong>{{employeeName}}</strong>,</p>
<p>You have been assigned a new task.</p>
<table style="width:100%;border-collapse:collapse;margin:16px 0">
  <tr><td style="padding:8px;border-bottom:1px solid #eee;color:#666">Task</td><td style="padding:8px;border-bottom:1px solid #eee"><strong>{{taskTitle}}</strong></td></tr>
  <tr><td style="padding:8px;border-bottom:1px solid #eee;color:#666">Project</td><td style="padding:8px;border-bottom:1px solid #eee"><strong>{{projectName}}</strong></td></tr>
  <tr><td style="padding:8px;border-bottom:1px solid #eee;color:#666">Due Date</td><td style="padding:8px;border-bottom:1px solid #eee"><strong>{{dueDate}}</strong></td></tr>
  <tr><td style="padding:8px;color:#666">Assigned By</td><td style="padding:8px">{{assignedBy}}</td></tr>
</table>
<a href="{{deepLink}}" class="btn">View Task</a>
