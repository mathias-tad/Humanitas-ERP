      "call": "db.getTenantConnectionById",
    },
    {
      "params": null,
      "sql": "SELECT ar.id as record_id, ar.user_id, ar.user_id, u.full_name, u.department as department_name, ar.shift_id, s.name as shift_name, s.name as shift_name, ar.actual_in as clock_in, ar.scheduled_out, EXTRACT(EPOCH FROM(CURRENT_TIMESTAMP - (ar.date + ar.scheduled_out):: timestamp)) / 3600 as estimated_ot_hours FROM attendance_records ar JOIN users u ON ar.user_id = u.id LEFT JOIN shifts s ON ar.shift_id = s.id WHERE ar.actual_in IS NOT NULL AND ar.actual_out IS NULL AND ar.scheduled_out IS NOT NULL AND(ar.date + ar.scheduled_out):: timestamp < CURRENT_TIMESTAMP ORDER BY ar.scheduled_out ASC",
    },
  ],
  "outcome": {
    "result": [],
  },
}
`;

