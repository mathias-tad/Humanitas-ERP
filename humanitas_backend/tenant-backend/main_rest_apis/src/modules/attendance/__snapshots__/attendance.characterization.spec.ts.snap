exports[`AttendanceService characterization populated database getUserAttendanceRecords 1`] = `
{
  "log": [
    {
      "args": [
        "tenant-1",
      ],
      "call": "db.getTenantConnectionById",
    },
    {
      "params": [
        "user-1",
        "2026-11-01",
        "2026-11-30",
      ],
      "sql": "SELECT sc.*, s.name as shift_name, s.start_time, s.end_time, s.color FROM schedules sc LEFT JOIN shifts s ON sc.shift_id = s.id WHERE sc.user_id = $1 AND sc.date >= $2 AND sc.date <= $3",
    },
    {
      "params": [
        "user-1",
        "2026-11-01",
        "2026-11-30",
      ],
      "sql": "SELECT DISTINCT ON(ar.date, ar.user_id) ar.id, ar.user_id, ar.date, ar.shift_id, ar.scheduled_in, ar.scheduled_out, ar.actual_in, ar.actual_out, ar.status, ar.work_hours, ar.remarks, ar.is_corrected, ar.corrected_by, ar.updated_at, ar.clock_method, ar.device_id, bd.name as device_name, s.name as shift_name, s.color as shift_color, corrector.full_name as corrected_by_name FROM attendance_records ar LEFT JOIN shifts s ON ar.shift_id = s.id LEFT JOIN biometric_devices bd ON ar.device_id = bd.id LEFT JOIN users corrector ON ar.corrected_by = corrector.id WHERE ar.user_id = $1 AND ar.date >= $2 AND ar.date <= $3 ORDER BY ar.date DESC, ar.user_id, ar.updated_at DESC",
    },
    {
      "params": [
        "user-1",
      ],
      "sql": "SELECT sa.*, sp.name as pattern_name, sp.rotation_type, sp.auto_rotate FROM shift_assignments sa LEFT JOIN schedule_patterns sp ON sa.pattern_id = sp.id WHERE sa.user_id = $1",
    },
    {
      "params": [
        "pattern-1",
      ],
      "sql": "SELECT rw.*, s.name as shift_name, s.start_time, s.end_time, s.color FROM rotation_weeks rw LEFT JOIN shifts s ON rw.shift_id = s.id WHERE rw.pattern_id = $1 ORDER BY rw.week_number",
    },
  ],
  "outcome": {
    "error": "RangeError",
    "message": "Invalid time value",
  },
}
`;

