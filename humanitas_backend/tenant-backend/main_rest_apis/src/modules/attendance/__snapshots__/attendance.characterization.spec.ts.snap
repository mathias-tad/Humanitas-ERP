exports[`AttendanceService characterization empty database getLatenessSummary 1`] = `
{
  "log": [
    {
      "args": [
        "tenant-1",
      ],
      "call": "db.getTenantConnectionById",
    },
    {
      "params": [
        "2026-11-10",
        "2026-11-09",
        11,
        2026,
      ],
      "sql": "SELECT u.id, u.full_name, u.department, u.avatar_url, COALESCE(day_stats.late_minutes, 0) as today_late, COALESCE(week_stats.total, 0) as week_late, COALESCE(month_stats.total, 0) as month_late FROM users u LEFT JOIN late_minutes_summary day_stats ON u.id = day_stats.user_id AND day_stats.date = $1 LEFT JOIN ( SELECT user_id, SUM(late_minutes) as total FROM late_minutes_summary WHERE week_start_date = $2 GROUP BY user_id ) week_stats ON u.id = week_stats.user_id LEFT JOIN ( SELECT user_id, SUM(late_minutes) as total FROM late_minutes_summary WHERE month = $3 AND year = $4 GROUP BY user_id ) month_stats ON u.id = month_stats.user_id WHERE u.is_active = true AND (COALESCE(day_stats.late_minutes, 0) > 0 OR COALESCE(week_stats.total, 0) > 0 OR COALESCE(month_stats.total, 0) > 0) AND u.id = 'user-1' ORDER BY today_late DESC, week_late DESC",
    },
  ],
  "outcome": {
    "result": [],
  },
}
`;

