exports[`AttendanceService characterization empty database processAbsentUsers 1`] = `
{
  "log": [
    {
      "args": [
        "tenant-1",
      ],
      "call": "db.getTenantConnectionById",
    },
    {
      "params": null,
      "sql": "SELECT data FROM settings WHERE category = 'general'",
    },
    {
      "params": null,
      "sql": "SELECT data FROM settings WHERE category = 'hr'",
    },
    {
      "params": [
        500,
        0,
        "2026-11-10",
      ],
      "sql": "WITH user_shifts_today AS ( SELECT usp.user_id, u.full_name, u.email, u.department, u.avatar_url, usp.start_date, usp.day_off_days, usp.auto_rotate_dayoff, sp.cycle_length_days, sp.shifts as pattern_shifts FROM user_shift_patterns usp JOIN users u ON usp.user_id = u.id LEFT JOIN shift_patterns sp ON usp.pattern_id = sp.id WHERE u.is_active = true AND (usp.end_date IS NULL OR usp.end_date >= $3) LIMIT $1 OFFSET $2 ) SELECT DISTINCT ust.user_id, ust.full_name, ust.email, ust.department, ust.avatar_url, s.id as shift_id, s.name as shift_name, s.start_time, s.end_time, s.grace_minutes, s.color, s.wait_for_absent_minutes, ust.day_off_days FROM user_shifts_today ust CROSS JOIN LATERAL ( SELECT CASE WHEN ust.cycle_length_days IS NOT NULL AND ust.pattern_shifts IS NOT NULL THEN -- Calculate which day in the cycle we're on ( SELECT (ps->>'shift_id')::uuid FROM jsonb_array_elements(ust.pattern_shifts) ps WHERE (ps->>'day_number')::int = (($3::date - ust.start_date::date) % ust.cycle_length_days) + 1 AND (ps->>'is_day_off')::boolean = false LIMIT 1 ) ELSE NULL END as calculated_shift_id ) calc LEFT JOIN shifts s ON s.id = calc.calculated_shift_id WHERE s.id IS NOT NULL ORDER BY ust.user_id",
    },
  ],
  "outcome": {
    "result": {
      "markedAbsent": 0,
    },
  },
}
`;

