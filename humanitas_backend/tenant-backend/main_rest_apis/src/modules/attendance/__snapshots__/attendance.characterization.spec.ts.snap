      "sql": "SELECT ar.*, u.full_name, u.email, u.department, u.avatar_url, s.name as shift_name, s.color as shift_color, bd.name as device_name, corrector.full_name as corrected_by_name, lms.late_minutes FROM attendance_records ar JOIN users u ON ar.user_id = u.id LEFT JOIN shifts s ON ar.shift_id = s.id LEFT JOIN biometric_devices bd ON ar.device_id = bd.id LEFT JOIN users corrector ON ar.corrected_by = corrector.id LEFT JOIN late_minutes_summary lms ON ar.user_id = lms.user_id AND ar.date = lms.date WHERE 1 = 1 AND ar.date >= $1 AND ar.date <= $2 AND ar.user_id = $3 AND ar.status = $4 AND u.department = $5 AND (ar.branch_id = $6 OR u.branch_id = $6) AND (ar.company_id = $7 OR u.company_id = $7) ORDER BY ar.date DESC, u.full_name",
    },
  ],
  "outcome": {
    "result": [],
  },
}
`;

