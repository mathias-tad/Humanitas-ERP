exports[`AttendanceService characterization empty database validateClockInTiming 1`] = `
{
  "log": [
    {
      "args": [
        "tenant-1",
      ],
      "call": "db.getTenantConnectionById",
    },
    {
      "args": [
        "tenant-1",
      ],
      "call": "db.getTenantConnectionById",
    },
    {
      "params": null,
      "sql": "SELECT data FROM settings WHERE category = 'general'",
    },
    {
      "params": [
        "user-1",
        "2026-11-10",
      ],
      "sql": "SELECT s.*, sh.name as shift_name, sh.start_time, sh.end_time, sh.grace_minutes, sh.color FROM schedules s LEFT JOIN shifts sh ON s.shift_id = sh.id WHERE s.user_id = $1 AND s.date = $2",
    },
    {
      "params": [
        "user-1",
      ],
      "sql": "SELECT sa.*, sp.name as pattern_name, sp.rotation_type, rw.shift_id, rw.days_off, s.id as shift_id, s.name as shift_name, s.start_time, s.end_time, s.grace_minutes, s.color FROM shift_assignments sa JOIN schedule_patterns sp ON sa.pattern_id = sp.id LEFT JOIN rotation_weeks rw ON rw.pattern_id = sp.id AND rw.week_number = sa.current_week_in_rotation LEFT JOIN shifts s ON rw.shift_id = s.id WHERE sa.user_id = $1",
    },
  ],
  "outcome": {
    "result": {
      "canClockIn": false,
      "isLate": false,
      "message": "You do not have a schedule assigned. Please contact your administrator.",
    },
  },
}
`;

